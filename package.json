{
  "name": "mfi-cbs-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:fetch": "curl -sf ${CBS_API_DOCS:-http://localhost:8080/v3/api-docs} -o openapi/cbs-api.json",
    "api:generate": "openapi-typescript openapi/cbs-api.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "typescript": "~5.9",
    "vite": "^8.3.5"
  },
  "overrides": {
    "path-to-regexp": "8.4.2"
  }
}
